// This is the blueprint for your Agentic GC Platform

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectStatus {
  PLANNING
  PERMITTING
  ACTIVE
  INSPECTION
  COMPLETED
}

enum TransactionType {
  CLIENT_DRAW_INVOICE
  SUB_PAYOUT
  GC_FEE_PROFIT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  DISPUTED
}

enum AgentRole {
  ORCHESTRATOR
  VISION_ANALYST
  LOGISTICS_BOT
  CLIENT_CONCIERGE
}

model Project {
  id                String         @id @default(uuid())
  name              String
  address           String
  qrCodeUrl         String?        // Link to the physical site's digital entry
  dedicatedPhone    String         @unique // The project-specific Twilio number
  status            ProjectStatus  @default(PLANNING)

  // Financials & Specs
  budgetTotal       Decimal
  progressPercent   Int            @default(0)

  // Agentic Memory: Stores the "context" for the AI managing this specific house
  agentContext      Json?          // Stores project-specific "rules" the AI follows

  // Relations
  milestones        Milestone[]
  communications    Communication[]
  media             SiteMedia[]
  subcontractors    ProjectSub[]
  clients           User[]
  clientUpdates     ClientUpdate[]
  transactions      Transaction[]
  createdAt         DateTime       @default(now())
}

model Milestone {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  title           String
  description     String
  status          String    // PENDING, IN_PROGRESS, VERIFIED, DELAYED

  scheduledStart  DateTime
  scheduledEnd    DateTime
  actualEnd       DateTime?

  // The DAG Dependencies (Self-Relation)
  dependsOn       Milestone[] @relation("MilestoneDependencies")
  prerequisiteFor Milestone[] @relation("MilestoneDependencies")

  // Logistics Meta
  assignedSubId   String?     // Link to ProjectSub
  leadTimeDays    Int         @default(0) // How much notice the sub needs

  // Vision Verification
  requiresPhoto   Boolean   @default(true)
  visionLog       String?   // AI's reasoning for marking this complete
}

model Communication {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  senderPhone     String
  rawMessage      String    // The original SMS or Voice Transcript
  aiInterpretation Json?     // What the AI "decided" this message meant
  wasActioned     Boolean   @default(false)
  direction       String    // INBOUND or OUTBOUND
  createdAt       DateTime  @default(now())
}

model SiteMedia {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  url             String
  type            String    // IMAGE or VIDEO
  visionAnalysis  String?   // Detailed AI description of what it "sees" in the photo
  timestamp       DateTime  @default(now())
}

model ProjectSub {
  id               String    @id @default(uuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id])
  name             String
  trade            String    // e.g., Plumbing, Electrical
  phoneNumber      String
  rating           Float     @default(5.0)
  stripeAccountId  String?   @unique // Stripe Connect ID to pay the sub
  onboardingStatus String    @default("PENDING") // PENDING, ACTIVE, RESTRICTED
}

model ClientUpdate {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])

  // The Curated Content
  title           String    // e.g., "Framing Complete & Plumbing Begins"
  executiveSummary String   // The AI-generated, white-glove update
  sentiment       String    // POSITIVE, NEUTRAL, ALERT

  // Media Linked to this Update
  curatedPhotoUrls String[] // Array of URLs filtered by the Concierge

  // Financial/Schedule Transparency
  isMilestonePayment Boolean @default(false)

  createdAt       DateTime  @default(now())
  published       Boolean   @default(false) // Allows GC to review, or set to auto-publish
}

model Transaction {
  id               String            @id @default(uuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id])
  milestoneId      String?           // Ties the money directly to the work
  amount           Decimal
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  stripeChargeId   String?           @unique
  stripeTransferId String?           @unique

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  role             String   // CLIENT or ADMIN
  stripeCustomerId String?  @unique // To charge the homeowner
  projects         Project[]
}
